# OpenAI-compatible LLM endpoint. Used by selayer_chat as defaults.
#
# These are the field names consulted by LLMConfig (in order):
#   OPENAI_API_KEY  -> LLMConfig.api_key
#   OPENAI_BASE_URL -> LLMConfig.base_url
#   OPENAI_MODEL    -> LLMConfig.model
#
# If you don't set a value here, selayer_chat falls back to the
# hardcoded defaults baked into LLMConfig.
#
# Real .env should NEVER be committed (see .gitignore).

OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.siemens.com/llm/v1
OPENAI_MODEL=qwen-3.6-27b
